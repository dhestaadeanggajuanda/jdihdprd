  "narrative": {
    "northStar": "Loket Resmi yang Rapi",
    "overview": "Sistem ini sengaja memakai standar kategori (arah \"canon\", dikonfirmasi pengguna): konvensi portal JDIH dan Material 3 diambil apa adanya, dan satu-satunya pembeda adalah kualitas eksekusi. Pengunjung harus langsung mengenali sumber resmi produk hukum, mencari lewat nomor + tahun atau kata kunci, lalu membaca jenis, Nomor/Tahun, dan status berlaku atau dicabut tanpa membuka dokumen. Tidak ada tanda tangan visual yang diselipkan; kerapian ritme, kontras, dan target sentuh adalah desainnya.\n\nPermukaannya dingin dan datar: landasan abu kebiruan, kartu putih berbingkai tipis, navy untuk elemen aktif dan hero, biru tegas untuk aksi. Hero memakai foto dokumentasi sidang yang bergantian di bawah selubung navy 72% sehingga teks putih tetap terbaca di atas foto apa pun. Satu keluarga sans (Public Sans, di-host sendiri) menanggung semua peran. Ponsel dirancang sebagai tujuan utama, bukan desktop yang diperkecil.",
    "keyCharacteristics": [
      "Pencarian di pusat: kartu putih di atas hero foto, tab Kata kunci dan Nomor & tahun.",
      "Status selalu berupa ikon + teks + warna, tidak pernah warna saja.",
      "Datar: kartu tanpa bayangan; kedalaman lewat lapisan nada dan garis tipis.",
      "Terang dan gelap penuh (Sistem/Terang/Gelap), skala teks 100/112,5/125% lewat rem.",
      "Target sentuh minimal 44-48px, fokus 3px terlihat di semua kontrol."
    ],
    "rules": [
      { "name": "The Status Triplet Rule", "body": "Status dokumen selalu berupa warna + ikon + kata. Warna saja tidak pernah cukup.", "section": "colors" },
      { "name": "The One Action Blue Rule", "body": "Biru aksi adalah satu-satunya warna interaktif dan satu-satunya warna seri grafik; navy menandai \"sedang aktif/resmi\", bukan \"bisa diklik\".", "section": "colors" },
      { "name": "The Veil Rule", "body": "Teks di atas foto hero hanya berdiri di atas selubung navy seragam 72%; tanpa selubung, tanpa teks di atas foto.", "section": "colors" },
      { "name": "The Rem Only Rule", "body": "Ukuran teks selalu rem. Piksel untuk teks merusak pengaturan \"Ukuran teks\" dan skala sistem.", "section": "typography" },
      { "name": "The Tabular Numerals Rule", "body": "Angka yang dibandingkan antarbaris (jumlah, tahun, nilai grafik) memakai angka tabular.", "section": "typography" },
      { "name": "The Flat Cards Rule", "body": "Kartu, panel, dan daftar tidak pernah berbayang; hanya sheet dan snackbar yang melayang.", "section": "elevation" }
    ],
    "dos": [
      "Do tampilkan jenis, Nomor/Tahun, dan status (ikon + kata + warna) pada setiap hasil.",
      "Do tulis ukuran teks dalam rem dan uji pada skala 125%.",
      "Do jaga target sentuh 44-48px dan cincin fokus 3px (putih di atas hero).",
      "Do definisikan setiap warna baru untuk mode terang dan gelap sekaligus.",
      "Do beri setiap grafik tabel padanan dan pakai satu warna seri (`blue`).",
      "Do letakkan teks di atas foto hanya di bawah selubung navy 72%."
    ],
    "donts": [
      "Don't pakai bayangan pada kartu atau daftar.",
      "Don't pakai warna saja untuk menandai status atau seri data.",
      "Don't jadikan navy warna tautan atau tombol; itu peran biru aksi.",
      "Don't perkecil tampilan desktop untuk ponsel; ponsel memakai bottom bar dan bottom sheet.",
      "Don't minta sumber daya pihak ketiga (font, ikon, gambar); semua di-host sendiri.",
      "Don't menambah keluarga font kedua atau ikon berbasis glyph/emoji."
    ]
  }
}
