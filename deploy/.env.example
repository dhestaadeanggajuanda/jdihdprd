# Variabel untuk deploy/docker-compose.yml. Salin menjadi deploy/.env (chmod 600; tidak di-commit).
# Berkas contoh ini TIDAK berisi rahasia; nilai di bawah hanya penanda.

# --- Database -----------------------------------------------------------------------------------
# Nama database JDIH di mysql_server.
DB_NAME=GANTI_NAMA_DATABASE
# Akun SELECT-only dibuat dengan api/db/grants.sql (lihat api/README.md, bagian Docker).
DB_RO_USER=jdih_ro
# Buat dengan: openssl rand -hex 24   (huruf/angka saja; sama dengan yang dipakai di grants.sql)
DB_RO_PASSWORD=GANTI_DENGAN_SANDI_ACAK
# Nama container MySQL di jaringan baota_net, dan port DI DALAM jaringan (bukan port yang
# dipublikasikan ke host).
DB_HOST=mysql_server
DB_PORT=3306

# --- Proxy tepercaya (batas laju per IP klien) ---------------------------------------------------
# Nginx Baota ada di HOST dan meneruskan ke 127.0.0.1:API_PORT. Di dalam container, sambungan itu
# terlihat berasal dari GATEWAY jaringan baota_net (bukan 127.0.0.1). Isi TRUST_PROXY dengan alamat
# itu (satu IP, atau daftar IP/CIDR dipisah koma):
#
#   docker network inspect baota_net --format '{{range .IPAM.Config}}{{.Gateway}}{{end}}'
#
# Pastikan dengan pengamatan, bukan hanya dugaan: jalankan satu permintaan dari host lalu lihat
# alamat asal yang dicatat API:
#
#   curl -s http://127.0.0.1:3000/health ; docker logs --tail 3 jdih_api
#
# Kolom "remoteAddress" pada log harus sama dengan nilai TRUST_PROXY. Jangan isi `true`, angka,
# atau 0.0.0.0/0 (ditolak saat start): itu membuat X-Forwarded-For buatan klien dipercaya dan
# batas laju bisa dihindari. Jangan isi seluruh subnet bila cukup gateway-nya: container lain di
# baota_net (mis. ildis_app) akan ikut dianggap proxy.
# Berisi penanda agar GAGAL KERAS bila lupa diganti (API menolak start), bukan diam-diam salah.
TRUST_PROXY=GANTI_DENGAN_ALAMAT_GATEWAY

# --- Jaringan dan port ---------------------------------------------------------------------------
# Port di loopback host yang dituju nginx Baota (samakan dengan proxy_pass di deploy/baota-locations.conf).
API_PORT=3000
# Nama jaringan Docker eksternal.
BAOTA_NETWORK=baota_net

# --- Berkas dokumen -------------------------------------------------------------------------------
# Volume Docker berisi berkas yang ditulis ildis_app; dipasang READ-ONLY.
DOKUMEN_VOLUME=jdihdprd_dokumen-uploads
# Sub-folder di dalam volume tempat PDF berada. Kosong = langsung di root volume.
FILES_SUBDIR=
# Host yang boleh dialihkan (302) untuk lampiran berupa URL penuh. Kosong = tidak ada pengalihan;
# baris dengan URL penuh (mis. https://bphn.jdihn.go.id/common/dokumen/x.pdf) dibaca dari volume
# memakai nama berkasnya. Isi (mis. bphn.jdihn.go.id,jdihn.go.id) hanya bila ada lampiran yang
# memang hanya ada di host lain.
FILE_REDIRECT_HOSTS=
# Folder gambar halaman Tentang (struktur organisasi, SOP) di dalam container; kosong = tidak ada.
PAGE_FILES_DIR=

# --- Peramban (CORS) dan batas laju ---------------------------------------------------------------
# Origin yang boleh memanggil API dari peramban, dipisah koma. SPA web dan API berada di SATU
# hostname (jdih.dprd.singkawangkota.go.id), jadi origin produksi = origin API sendiri;
# https://localhost untuk aplikasi Android (Capacitor). Tambahkan origin sementara (mis.
# http://localhost:PORT) HANYA selama tahap uji SPA dan hapus lagi sesudahnya.
CORS_ORIGINS=https://jdih.dprd.singkawangkota.go.id,https://localhost
RATE_LIMIT_MAX=120

# --- Pengguna proses dan batas sumber daya ----------------------------------------------------------
# Pengguna proses di container. Bila berkas dokumen tidak terbaca oleh 1000:1000, periksa dulu:
#   docker exec ildis_app ls -ln <folder-dokumen>
# lalu isi uid/gid pemilik/grup berkas, atau ubah izin menjadi terbaca semua pengguna (644/755).
API_UID=1000
API_GID=1000
API_MEM_LIMIT=384m
API_CPUS=1.0
API_PIDS_LIMIT=128

# --- Image ------------------------------------------------------------------------------------------
NODE_IMAGE=node:24-alpine
JDIH_API_TAG=local
