{
  "name": "jdihdprd",
  "version": "0.0.1",
  "private": true,
  "description": "Frontend JDIH DPRD Kota Singkawang (Quasar: web dan Android)",
  "keywords": [
    "quasar",
    "quasar-app",
    "quasar-app-vite",
    "quasar-cli",
    "vite",
    "vue",
    "vuejs"
  ],
  "type": "module",
  "scripts": {
    "lint": "oxfmt && oxlint --fix",
    "lint:check": "oxfmt --check && oxlint",
    "dev": "quasar dev",
    "build": "quasar build",
    "postinstall": "quasar prepare --silent",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:security": "node scripts/check-security.mjs",
    "check": "npm run lint:check && npm run lint:security && npm test",
    "test:e2e": "node tests/e2e/check.mjs",
    "test:api": "npm --prefix api test"
  },
  "dependencies": {
    "@quasar/extras": "^2.1.0",
    "dompurify": "^3.4.18",
    "quasar": "^2.35.5",
    "vue": "^3.5.22",
    "vue-router": "^5.0.6"
  },
  "devDependencies": {
    "@quasar/app-vite": "^3.10.4",
    "@vitejs/plugin-vue": "^6.0.11",
    "autoprefixer": "^10.4.27",
    "axe-core": "^4.14.1",
    "jsdom": "^31.0.1",
    "oxfmt": "^0.x",
    "oxlint": "^1.x",
    "postcss": "^8.5.8",
    "puppeteer-core": "^25.18.1",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">= 26 || ^24 || ^22.12"
  },
  "productName": "JDIH DPRD Kota Singkawang"
}
